{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "YouTube Systems Library Manifest",
  "type": "object",
  "required": ["id", "name", "category", "source", "reconstruction_status", "inputs", "outputs", "tools", "steps"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "required": ["type", "url"],
      "properties": {
        "type": {"enum": ["youtube", "video", "article", "other"]},
        "url": {"type": "string", "minLength": 1},
        "creator": {"type": "string"},
        "title": {"type": "string"}
      },
      "additionalProperties": true
    },
    "reconstruction_status": {"enum": ["DRAFT", "RECONSTRUCTED", "VERIFIED"]},
    "inputs": {"type": "array", "items": {"type": "string"}},
    "outputs": {"type": "array", "items": {"type": "string"}},
    "tools": {"type": "array", "items": {"type": "string"}},
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "action", "provenance", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "action": {"type": "string", "minLength": 1},
          "tool": {"type": ["string", "null"]},
          "provenance": {"enum": ["EXACT", "RECONSTRUCTED", "INFERRED"]},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["source_url", "provenance"],
              "properties": {
                "source_url": {"type": "string", "minLength": 1},
                "timestamp": {"type": ["string", "null"]},
                "provenance": {"enum": ["EXACT", "RECONSTRUCTED", "INFERRED"]},
                "note": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "prompts": {"type": "array"},
    "notes": {"type": "string"}
  },
  "additionalProperties": true
}
